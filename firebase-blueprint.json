{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representing a teacher or student.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user ID matching auth UID." },
        "displayName": { "type": "string", "description": "User display name." },
        "email": { "type": "string", "description": "User email address." },
        "role": { "type": "string", "enum": ["teacher", "student", "admin"], "description": "User role." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["userId", "displayName", "email"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Exam form definition with configuration and questions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Exam unique ID." },
        "ownerId": { "type": "string", "description": "User ID of creator/teacher." },
        "title": { "type": "string", "description": "Title of the exam." },
        "description": { "type": "string", "description": "Description of the exam." },
        "durationMinutes": { "type": "integer", "description": "Duration in minutes." },
        "passingScorePercent": { "type": "integer", "description": "Passing grade percent." },
        "shuffleQuestions": { "type": "boolean", "description": "Whether to shuffle questions." },
        "preventScreenshots": { "type": "boolean", "description": "Whether to block screenshots." },
        "maxViolationsAllowed": { "type": "integer", "description": "Max cheating attempts." },
        "questionsJson": { "type": "string", "description": "Serialized questions list." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["id", "ownerId", "title"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Completed student exam submission.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Submission unique ID." },
        "examId": { "type": "string", "description": "ID of submitted exam." },
        "examTitle": { "type": "string", "description": "Title of submitted exam." },
        "studentId": { "type": "string", "description": "Student UID or code." },
        "studentName": { "type": "string", "description": "Student name." },
        "studentCode": { "type": "string", "description": "Student code." },
        "score": { "type": "integer", "description": "Earned score." },
        "totalPoints": { "type": "integer", "description": "Max possible points." },
        "percentage": { "type": "number", "description": "Percentage score." },
        "isPassed": { "type": "boolean", "description": "Whether passing grade met." },
        "answersMapJson": { "type": "string", "description": "Serialized answers." },
        "timeSpentSeconds": { "type": "integer", "description": "Time taken in seconds." },
        "violationsCount": { "type": "integer", "description": "Cheating violations count." },
        "submittedAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." }
      },
      "required": ["id", "examId", "studentId", "studentName", "score", "totalPoints"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document."
    },
    "/users/{userId}/exams/{examId}": {
      "schema": "Exam",
      "description": "Exams created by this user."
    },
    "/users/{userId}/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Exam submissions recorded for this user or student."
    }
  }
}
